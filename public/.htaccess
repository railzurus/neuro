# Наш index.html всегда приоритетнее дефолтного index.php Beget
DirectoryIndex index.html

# SPA-фолбэк: все несуществующие пути отдаём app.html, чтобы React Router
# обрабатывал маршруты (/compose, /review, /listen) и обновление страницы
# по прямой ссылке не давало 404.
#
# Именно app.html, а не index.html: в index.html при сборке вставляется
# предрендеренная главная (scripts/prerender.mjs). Отдавай мы его на все
# маршруты — человек, открывший ссылку на заказ из письма, сначала увидел бы
# главную страницу и только потом свой заказ. В app.html корень пустой.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^(index|app)\.html$ - [L]

  # Предрендеренные страницы лежат рядом файлами: /privacy → /privacy.html
  # (см. scripts/prerender.mjs). Файлом, а не каталогом с index.html внутри:
  # иначе Apache редиректил бы /privacy на /privacy/, а в карте сайта адрес
  # без слэша. Условие -f проверяет наличие файла, поэтому маршруты без
  # предрендера сюда не попадают и уходят на фолбэк ниже.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /app.html [L]
</IfModule>

# Кэширование статики (хэшированные ассеты Vite можно держать долго)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# index.html не кэшируем, чтобы новые сборки подхватывались сразу
<IfModule mod_headers.c>
  <FilesMatch "^(index|app)\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
